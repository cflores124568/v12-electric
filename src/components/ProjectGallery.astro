---
const projects = [
  {
    title: "EV charging installation",
    category: "EV charging",
    image: "/images/proof/ev-charger-installation.webp",
    alt: "Installed EV charging equipment and organized service hardware",
  },
  {
    title: "Service upgrade",
    category: "Power systems",
    image: "/images/proof/service-upgrade.webp",
    alt: "Open service equipment with organized conductors and upgraded components",
  },
  {
    title: "Two-story chandelier",
    category: "Residential lighting",
    image: "/images/proof/chandelier-installation.webp",
    alt: "Two-story chandelier installation in a finished residential interior",
  },
  {
    title: "Layered ceiling lighting",
    category: "Lighting controls",
    image: "/images/proof/ceiling-lighting.webp",
    alt: "Custom ceiling lighting with multiple fixture layers",
  },
  {
    title: "Commercial service",
    category: "Commercial",
    image: "/images/proof/commercial-service.webp",
    alt: "Commercial electrical service equipment in a working space",
  },
  {
    title: "Electrical inspection",
    category: "Inspection",
    image: "/images/proof/electrical-inspection.webp",
    alt: "Electrician inspecting electrical equipment with a handheld meter",
  },
];

const [evCharging, serviceUpgrade, chandelier, lighting] = projects;
---

<section class="project-proof-section" aria-labelledby="project-proof-title">
  <div class="project-proof-heading section-pad" data-reveal="up">
    <p class="section-label">Recent work</p>
    <h2 id="project-proof-title">Built for the property, not the template.</h2>
    <p class="body-large">
      A closer look at the equipment, routing, and finished details behind the work.
    </p>
  </div>

  <div class="project-proof-layout section-pad">
    <figure class="project-proof-lead" data-reveal="image">
      <img src={serviceUpgrade.image} width="1920" height="1440" alt={serviceUpgrade.alt} loading="lazy" />
      <figcaption>
        <span>Palm Springs / power systems</span>
        <strong>{serviceUpgrade.title}</strong>
      </figcaption>
    </figure>

    <div class="project-proof-copy" data-reveal="up">
      <p class="section-label">What the work includes</p>
      <p>
        Clear service equipment, dedicated circuits, and work that can be inspected and maintained
        later.
      </p>
      <a class="text-link" href="/projects/">See project work <span aria-hidden="true">→</span></a>
    </div>

    <div class="project-proof-supporting">
      {
        [evCharging, chandelier, lighting].map((project) => (
          <figure data-reveal="image">
            <img src={project.image} width="1920" height="1440" alt={project.alt} loading="lazy" />
            <figcaption>
              <span>{project.category}</span>
              <strong>{project.title}</strong>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
