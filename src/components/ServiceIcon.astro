---
interface Props {
  name: "power" | "lighting" | "design" | "commercial" | "ev-charging" | "shield-check";
}

const { name } = Astro.props;
---

{
  name === "power" && (
    <svg viewBox="0 0 32 32" aria-hidden="true">
      <path d="M18.5 2 7 18h8l-1.5 12L25 13h-8l1.5-11Z" fill="currentColor" />
    </svg>
  )
}
{
  name === "lighting" && (
    <svg viewBox="0 0 32 32" aria-hidden="true">
      <path
        d="M16 3a9 9 0 0 0-5.7 16v3.4h11.4V19A9 9 0 0 0 16 3Zm-4 22h8m-7 3h6"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  )
}
{
  name === "design" && (
    <svg viewBox="0 0 32 32" aria-hidden="true">
      <path
        d="m5 23 3.7 3.7L27 8.4 23.3 4.7 5 23Zm0 0-1 5 4.7-1.3M20.8 7.2l4 4"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  )
}
{
  name === "commercial" && (
    <svg viewBox="0 0 32 32" aria-hidden="true">
      <path
        d="M6 28V6h10v22M20 28V13h8v15M9 10h4M9 16h4M9 22h4M23 17h3M23 22h3"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  )
}
{
  name === "ev-charging" && (
    <svg viewBox="0 0 32 32" aria-hidden="true">
      <path
        d="M12 3v6M18 3v6M9 9h14v8a5 5 0 0 1-5 5h-4a5 5 0 0 1-5-5V9Z"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linejoin="round"
      />
      <path
        d="M17 13l-2.5 4.5h2.5l-2.5 4.5"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  )
}
{
  name === "shield-check" && (
    <svg viewBox="0 0 32 32" aria-hidden="true">
      <path
        d="M16 3l11 4v8c0 8-5 13-11 15C10 28 5 23 5 15V7l11-4Z"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linejoin="round"
      />
      <path
        d="M11.5 16l3 3 6-6.5"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  )
}
