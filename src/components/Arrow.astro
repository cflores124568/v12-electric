---
interface Props {
  name?: "right" | "up" | "down";
}

const { name = "right" } = Astro.props;

const paths = {
  right: "M2.5 8h11M9.5 4l4 4-4 4",
  up: "M8 13.5v-11M4 6.5l4-4 4 4",
  down: "M4 6l4 4 4-4",
};
---

<span class:list={["arrow", `arrow-${name}`]} aria-hidden="true">
  <svg viewBox="0 0 16 16"><path d={paths[name]} /></svg>
</span>
