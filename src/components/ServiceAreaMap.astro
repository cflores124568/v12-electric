---
import { serviceAreaCities } from "../data/service-areas";

const canPrefillInquiryCity = Boolean(import.meta.env.PUBLIC_CONTACT_EMAIL);
const regions = [
  {
    name: "West Valley",
    cities: ["palm-springs-electrician", "cathedral-city-electrician", "desert-hot-springs-electrician"],
  },
  {
    name: "Central Valley",
    cities: ["rancho-mirage-electrician", "palm-desert-electrician", "indian-wells-electrician", "la-quinta-electrician"],
  },
  {
    name: "East Valley",
    cities: ["indio-electrician", "coachella-electrician"],
  },
] as const;

const cityBySlug = Object.fromEntries(serviceAreaCities.map((city) => [city.slug, city]));
const selectedCity = serviceAreaCities[0];
---

<section
  class="service-area-index"
  aria-labelledby="service-area-title"
  data-service-area-index
  data-prefill-city={String(canPrefillInquiryCity)}
>
  <div class="service-area-index-intro section-pad">
    <p class="section-label">Coachella Valley coverage</p>
    <h2 id="service-area-title">Where we work.</h2>
    <p>
      Select a city to see the project types we are asked about most often, then call or text us
      with the address and scope.
    </p>
    <div class="service-area-mark" aria-hidden="true">
      <span>Coachella</span>
      <strong>Valley</strong>
      <i></i>
    </div>
  </div>

  <div class="service-area-index-content section-pad">
    <div class="service-area-groups" aria-label="Cities served">
      {
        regions.map((region) => (
          <section class="service-area-group">
            <h3>{region.name}</h3>
            <div>
              {
                region.cities.map((slug) => {
                  const city = cityBySlug[slug];
                  return (
                    <button
                      type="button"
                      data-city-trigger={city.slug}
                      data-city-name={city.city}
                      data-city-focus={city.focus}
                      data-city-note={city.fieldNote}
                      data-city-url={`/service-areas/${city.slug}/`}
                      aria-pressed={city.slug === selectedCity.slug ? "true" : "false"}
                    >
                      {city.city}
                    </button>
                  );
                })
              }
            </div>
          </section>
        ))
      }
    </div>

    <aside class="service-area-detail" aria-live="polite">
      <p class="section-label">Selected area</p>
      <h3 data-city-name>{selectedCity.city}</h3>
      <p data-city-focus>{selectedCity.focus}</p>
      <p class="service-area-detail-note" data-city-note>{selectedCity.fieldNote}</p>
      <div class="service-area-detail-actions">
        <a class="text-link" data-city-page href={`/service-areas/${selectedCity.slug}/`}>
          <span data-city-page-label>View {selectedCity.city} page</span>
          <span aria-hidden="true">→</span>
        </a>
        <a
          class="text-link"
          data-city-contact
          href={canPrefillInquiryCity ? `/contact/?city=${selectedCity.slug}` : "/contact/"}
        >
          Text us about your project <span aria-hidden="true">→</span>
        </a>
      </div>
    </aside>
  </div>
</section>

<script>
  const serviceAreaRoot = document.querySelector<HTMLElement>("[data-service-area-index]");
  const cityTriggers = serviceAreaRoot?.querySelectorAll<HTMLButtonElement>("[data-city-trigger]");
  const cityName = serviceAreaRoot?.querySelector<HTMLElement>("[data-city-name]");
  const cityFocus = serviceAreaRoot?.querySelector<HTMLElement>("[data-city-focus]");
  const cityNote = serviceAreaRoot?.querySelector<HTMLElement>("[data-city-note]");
  const cityPage = serviceAreaRoot?.querySelector<HTMLAnchorElement>("[data-city-page]");
  const cityPageLabel = serviceAreaRoot?.querySelector<HTMLElement>("[data-city-page-label]");
  const cityContact = serviceAreaRoot?.querySelector<HTMLAnchorElement>("[data-city-contact]");

  cityTriggers?.forEach((trigger) => {
    trigger.addEventListener("click", () => {
      cityTriggers.forEach((item) => {
        item.setAttribute("aria-pressed", String(item === trigger));
      });
      if (cityName) cityName.textContent = trigger.dataset.cityName ?? "";
      if (cityFocus) cityFocus.textContent = trigger.dataset.cityFocus ?? "";
      if (cityNote) cityNote.textContent = trigger.dataset.cityNote ?? "";
      if (cityPage) {
        cityPage.href = trigger.dataset.cityUrl ?? "/";
      }
      if (cityPageLabel) cityPageLabel.textContent = `View ${trigger.dataset.cityName ?? "city"} page`;
      if (cityContact && serviceAreaRoot?.dataset.prefillCity === "true") {
        cityContact.href = `/contact/?city=${encodeURIComponent(trigger.dataset.cityTrigger ?? "")}`;
      }
    });
  });
</script>
