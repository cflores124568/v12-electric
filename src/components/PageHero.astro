---
interface Props {
  eyebrow: string;
  title: string;
  description: string;
  image: string;
  alt: string;
}

const { eyebrow, title, description, image, alt } = Astro.props;
---

<section class="interior-hero">
  <div class="interior-hero-copy">
    <p class="section-label" data-reveal="up">{eyebrow}</p>
    <h1 data-reveal="up">{title}</h1>
    <p data-reveal="up" data-delay="1">{description}</p>
  </div>

  <div class="page-strike" aria-hidden="true">
    <span></span>
    <svg viewBox="0 0 118 286" role="presentation">
      <path d="M79 0 20 132h37L5 286l108-177H70L79 0Z"></path>
    </svg>
  </div>

  <figure class="interior-hero-media" data-reveal="image">
    <img src={image} width="1536" height="1024" alt={alt} fetchpriority="high" />
  </figure>
</section>
