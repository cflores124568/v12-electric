---
import BrandLogo from "./BrandLogo.astro";
import { navItems } from "../data/site";

interface Props {
  active?: string;
}

const { active = "" } = Astro.props;
---

<header class="site-header" data-reveal="fade">
  <BrandLogo class="header-logo" />

  <nav id="primary-nav" class="primary-nav" aria-label="Primary navigation">
    {
      navItems.map((item) => (
        <a href={item.href} aria-current={active === item.label.toLowerCase() ? "page" : undefined}>
          {item.label}
        </a>
      ))
    }
  </nav>

  <a class="button button-primary header-cta" href="/contact/">Plan Your Project</a>

  <button
    class="menu-toggle"
    type="button"
    aria-expanded="false"
    aria-controls="mobile-menu"
    aria-label="Open menu"
  >
    <span></span>
    <span></span>
    <span></span>
  </button>

  <div id="mobile-menu" class="mobile-menu" aria-hidden="true" inert>
    <nav aria-label="Mobile navigation">
      {
        navItems.map((item) => (
          <a href={item.href} aria-current={active === item.label.toLowerCase() ? "page" : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>
    <a class="button button-light" href="/contact/">Plan Your Project</a>
  </div>
</header>
