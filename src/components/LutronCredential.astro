---
import { lutronCredential } from "../data/site";

interface Props {
  compact?: boolean;
  link?: boolean;
}

const { compact = false, link = false } = Astro.props;
const headingId = compact ? undefined : "lutron-credential-title";
---

<section
  class:list={["lutron-credential", { "lutron-credential-compact": compact }]}
  id={!compact ? "lutron-credential" : undefined}
  aria-labelledby={headingId}
>
  <span class="lutron-credential-mark">
    <img
      src="/images/brands/lutron-logo-horizontal.png"
      width="480"
      height="160"
      alt="Lutron"
    />
  </span>
  <div class="lutron-credential-copy">
    <p class="section-label">{lutronCredential.eyebrow}</p>
    <h2 id={headingId}>{compact ? lutronCredential.shortLabel : lutronCredential.label}</h2>
    {!compact && <p>{lutronCredential.description}</p>}
  </div>
  {link && (
    <a class="text-link lutron-credential-link" href="/services/lutron-lighting-controls/">
      Explore Lutron controls <span aria-hidden="true">↗</span>
    </a>
  )}
</section>
