---
import BrandLogo from "./BrandLogo.astro";
import { yelpProfile } from "../data/site";
---

<footer class="site-footer">
  <div class="footer-lead">
    <div class="footer-brand">
      <BrandLogo />
      <p>Power, lighting, and electrical planning for Coachella Valley properties.</p>
      <a
        class="footer-yelp"
        href={yelpProfile.url}
        target="_blank"
        rel="noopener"
      >
        <img src="/images/brands/yelp-logo-dark-bg.svg" width="1000" height="385" alt="Yelp" />
        <span>{yelpProfile.label} <span aria-hidden="true">↗</span></span>
      </a>
      <p class="footer-license">California contractor license #1114737</p>
    </div>

    <section class="footer-inquiry" id="project-inquiries" aria-labelledby="footer-inquiry-title">
      <p class="footer-kicker">Have a project in mind?</p>
      <h2 id="footer-inquiry-title">Start with a clear electrical plan.</h2>
      <p>Tell us what you are working on, where the property is, and what needs attention.</p>
      <div class="footer-actions">
        <a class="footer-phone" href="tel:+17605676593">Call (760) 567-6593</a>
        <a class="footer-contact-link" href="/contact/">
          Start a conversation <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>
  </div>

  <div class="footer-directory">
    <nav class="footer-nav" aria-label="Footer navigation">
      <div class="footer-nav-group">
        <h2>Services</h2>
        <ul>
          <li><a href="/services/electrical-systems/">Electrical systems</a></li>
          <li><a href="/services/ev-charger-installation/">EV charger installation</a></li>
          <li><a href="/services/panel-service-upgrades/">Panel and service upgrades</a></li>
          <li><a href="/services/lutron-lighting-controls/">Lighting and controls</a></li>
          <li><a href="/services/design-planning/">Design and planning</a></li>
        </ul>
      </div>

      <div class="footer-nav-group">
        <h2>Company</h2>
        <ul>
          <li><a href="/about/">About</a></li>
          <li><a href="/process/">Our process</a></li>
          <li><a href="/projects/">Projects</a></li>
          <li><a href="/contact/">Contact</a></li>
        </ul>
      </div>
    </nav>

    <section class="footer-coverage" aria-labelledby="footer-coverage-title">
      <h2 id="footer-coverage-title">Coachella Valley coverage</h2>
      <p>
        Serving nine communities from Palm Springs and Desert Hot Springs through La Quinta,
        Indio, and Coachella.
      </p>
      <a href="/service-areas/">View the service area <span aria-hidden="true">→</span></a>
    </section>
  </div>

  <div class="footer-meta">
    <p>© 2026 V12 Electric. All rights reserved.</p>
    <nav class="footer-legal" aria-label="Legal">
      <a href="/privacy/">Privacy</a>
      <a href="/terms/">Terms</a>
    </nav>
    <a class="footer-back-to-top" href="#top">Back to top <span aria-hidden="true">↑</span></a>
  </div>
</footer>
