---
import type { Service } from "../data/site";

interface Props {
  service: Service;
}

const { service } = Astro.props;
const scopeId = `${service.slug}-scope`;
const titleId = `${scopeId}-title`;
---

{
  service.layout === "split" && (
    <section id={scopeId} class="service-inclusions section-pad" aria-labelledby={titleId}>
      <div class="section-heading compact" data-reveal="up">
        <p class="section-label">Typical scope</p>
        <h2 id={titleId}>What the job includes.</h2>
      </div>
      <ul class="inclusion-list">
        {service.inclusions.map((item, index) => (
          <li data-reveal="up" data-delay={String(index % 3)}>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <div>
              <strong>{item.label}</strong>
              <p>{item.detail}</p>
            </div>
          </li>
        ))}
      </ul>
    </section>
  )
}

{
  service.layout === "cinematic" && (
    <section id={scopeId} class="service-scope-index" aria-labelledby={titleId}>
      <div class="service-scope-index-heading section-pad" data-reveal="up">
        <p class="section-label">Typical scope</p>
        <h2 id={titleId}>Where the work lands.</h2>
      </div>
      <ol class="service-scope-index-list">
        {service.inclusions.map((item, index) => (
          <li data-reveal="up">
            <span aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
            <div>
              <strong>{item.label}</strong>
              <p>{item.detail}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>
  )
}

{
  service.layout === "ledger" && (
    <section id={scopeId} class="service-scope-ledger section-pad" aria-labelledby={titleId}>
      <div class="service-scope-ledger-heading" data-reveal="up">
        <p class="section-label">Typical scope</p>
        <h2 id={titleId}>The scope, line by line.</h2>
      </div>
      <dl class="service-scope-ledger-list">
        {service.inclusions.map((item, index) => (
          <div data-reveal="up">
            <dt>{String(index + 1).padStart(2, "0")}</dt>
            <dd>
              <strong>{item.label}</strong>
              <p>{item.detail}</p>
            </dd>
          </div>
        ))}
      </dl>
    </section>
  )
}
