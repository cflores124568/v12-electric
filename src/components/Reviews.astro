---
import { reviewProof } from "../data/reviews";
import { googleReviewUrl } from "../data/site";
import Arrow from "./Arrow.astro";
import GoogleMark from "./GoogleMark.astro";

const [featuredReview, ...remainingReviews] = reviewProof;
const supportingReviews = remainingReviews.slice(0, 3);
---

<section class="review-contact" aria-labelledby="reviews-title">
  <div class="review-feature section-pad" data-reveal="up">
    <div class="review-feature-copy">
      <p class="section-label">What customers say</p>
      <h2 id="reviews-title">Straight answers. Clean work.</h2>
      <blockquote>“{featuredReview.excerpt ?? featuredReview.text}”</blockquote>
      <footer>
        <strong>{featuredReview.author}</strong>
        <span>
          {featuredReview.source === "Google" && <GoogleMark />}{" "}{featuredReview.source}
          {featuredReview.date && ` · ${featuredReview.date}`}
        </span>
      </footer>
      <details class="review-full">
        <summary>Read full review <Arrow name="down" /></summary>
        <p>“{featuredReview.text}”</p>
        <p class="review-continuity">
          Reviews appear as customers wrote them. Some were published under our previous business
          name, TruLuxe Electric.
        </p>
      </details>
    </div>

    {
      featuredReview.photo && (
        <figure class="review-feature-media" data-reveal="image">
          <img
            src={featuredReview.photo.src}
            width="1600"
            height="1200"
            alt={featuredReview.photo.alt}
            loading="lazy"
          />
          <figcaption>Palm Springs / lighting installation</figcaption>
        </figure>
      )
    }
  </div>

  <aside class="contact-prompt section-pad" aria-label="Contact V12 Electric">
    <h2>Call or text Eric.</h2>
    <a class="contact-prompt-phone" href="tel:+17605676593">(760) 567-6593</a>
    <div class="contact-prompt-actions">
      <a class="button button-outline" href="tel:+17605676593">Call <Arrow /></a>
      <a class="button button-outline" href="sms:+17605676593">Text <Arrow /></a>
      <a class="button button-outline" href={googleReviewUrl} target="_blank" rel="noreferrer">
        <GoogleMark /> Leave a Google review <Arrow />
      </a>
    </div>
  </aside>
</section>

<section class="review-list section-pad" aria-label="More customer reviews">
  {
    supportingReviews.map((review) => (
      <article data-reveal="up">
        <blockquote>“{review.text}”</blockquote>
        <footer>
          {review.author} · {review.source === "Google" && <GoogleMark />} {review.source}
        </footer>
      </article>
    ))
  }
</section>
