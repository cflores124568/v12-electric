---
import InteriorLayout from "../layouts/InteriorLayout.astro";
import PageHero from "../components/PageHero.astro";
import { projects } from "../data/site";

const projectListSchema = {
  "@type": "ItemList",
  name: "Selected V12 Electric projects",
  itemListElement: projects.map((project, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: project.title,
    description: project.description,
    image: `https://v12electric.com${project.image}`,
  })),
};
---

<InteriorLayout
  title="Electrical Projects in Coachella Valley | V12 Electric"
  description="See selected V12 Electric panel, lighting, wiring, and electrical planning work completed for Coachella Valley homes and businesses."
  image="/images/featured-kitchen.webp"
  imageAlt="Contemporary kitchen with carefully coordinated architectural lighting"
  breadcrumbs={[{ name: "Projects", path: "/projects/" }]}
  structuredData={projectListSchema}
  active="projects"
>
  <PageHero
    eyebrow="Selected work"
    title="Completed electrical work."
    description="A selection of lighting, service, inspection, and electrical-system projects."
    image="/images/featured-kitchen.webp"
    alt="Contemporary kitchen with carefully coordinated architectural lighting"
  />

  <section class="intro-split section-pad">
    <p class="section-label" data-reveal="up">Project standard</p>
    <div data-reveal="up">
      <h2>Plan the power before the finishes go in.</h2>
      <p class="body-large">
        Every project starts with the equipment, routing, and loads that need to be addressed, then
        moves through a clean installation and final testing.
      </p>
    </div>
  </section>

  <section class="project-list section-pad" aria-label="Selected electrical projects">
    {
      projects.map((project, index) => (
        <article class="project-card" data-reveal="up">
          <figure class="project-card-media media-frame">
            <img src={project.image} width="1894" height="1086" alt={project.alt} loading="lazy" />
          </figure>
          <div class="project-card-copy">
            <span class="index-number">0{index + 1}</span>
            <div>
              <p class="section-label">{project.category}</p>
              <h2>{project.title}</h2>
              <p>{project.description}</p>
            </div>
          </div>
        </article>
      ))
    }
  </section>

  <section class="project-principles section-pad">
    <div data-reveal="up">
      <p class="section-label">What stays consistent</p>
      <h2>Plan clearly.<br />Install cleanly.<br />Verify everything.</h2>
    </div>
    <ol>
      <li data-reveal="up"><span>01</span><p>Systems coordinated before installation begins.</p></li>
      <li data-reveal="up"><span>02</span><p>Work organized for safety, clarity, and serviceability.</p></li>
      <li data-reveal="up"><span>03</span><p>Final testing and a clear owner walkthrough.</p></li>
    </ol>
  </section>
</InteriorLayout>
