---
import InteriorLayout from "../layouts/InteriorLayout.astro";
import { projects } from "../data/site";
import "../styles/luxury-interiors.css";

const projectListSchema = {
  "@type": "ItemList",
  name: "Selected V12 Electric projects",
  itemListElement: projects.map((project, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: project.title,
    description: project.description,
    image: `https://v12electric.com${project.image}`,
  })),
};
---

<InteriorLayout
  title="Electrical Projects in Coachella Valley | V12 Electric"
  description="See selected V12 Electric panel, lighting, wiring, and electrical planning work completed for Coachella Valley homes and businesses."
  image="/images/projects/desert-home-landscape-lighting.webp"
  imageAlt="Modern desert home at dusk with facade, path, and landscape lighting"
  breadcrumbs={[{ name: "Projects", path: "/projects/" }]}
  structuredData={projectListSchema}
  active="projects"
  overlayHeader
  shellClass="luxury-shell luxury-projects-shell"
>
  <section class="luxury-hero luxury-projects-hero" aria-labelledby="projects-hero-title">
    <figure class="luxury-hero-media">
      <img
        src="/images/projects/desert-home-landscape-lighting.webp"
        width="1600"
        height="900"
        alt="Modern desert residence with layered facade, path, and landscape lighting"
        fetchpriority="high"
      />
    </figure>
    <div class="luxury-hero-shade" aria-hidden="true"></div>
    <span class="luxury-hero-strike" aria-hidden="true"></span>
    <div class="luxury-hero-copy" data-reveal="up">
      <p class="luxury-kicker">Selected work</p>
      <h1 id="projects-hero-title">The work behind exceptional properties.</h1>
      <p>
        Lighting, power, charging, and electrical systems documented from plan to final
        commissioning.
      </p>
      <div class="luxury-actions">
        <a class="luxury-button luxury-button-primary" href="#selected-projects">View projects</a>
      </div>
    </div>
  </section>

  <section class="luxury-project-standard" aria-labelledby="project-standard-title">
    <div class="luxury-project-standard-layout">
      <figure data-reveal="image">
        <img
          src="/images/design-planning.webp"
          width="1536"
          height="1024"
          alt="Electrical design being marked on an architectural plan"
          loading="lazy"
        />
      </figure>
      <figure data-reveal="image">
        <img
          src="/images/projects/new-build-conduit.webp"
          width="1600"
          height="900"
          alt="Neatly routed conduit installed before wall finishes"
          loading="lazy"
        />
      </figure>
      <div class="luxury-project-standard-copy" data-reveal="up">
        <h2 id="project-standard-title">Plan the power before the finishes go in.</h2>
        <p>
          Equipment, routing, loads, and controls are resolved first. Clean installation and final
          testing follow.
        </p>
      </div>
      <figure data-reveal="image">
        <img
          src="/images/projects/kitchen-pendant-lighting.webp"
          width="1600"
          height="900"
          alt="Finished kitchen with layered pendant and recessed lighting"
          loading="lazy"
        />
      </figure>
      <div class="luxury-project-standard-track" aria-label="Project sequence">
        <span>Plan</span>
        <span>Build</span>
        <span>Commission</span>
      </div>
    </div>
  </section>

  <section id="selected-projects" class="luxury-project-gallery" aria-labelledby="project-gallery-title">
    <div class="luxury-project-gallery-grid">
      <header class="luxury-project-gallery-heading" data-reveal="up">
        <h2 id="project-gallery-title">Selected projects.</h2>
        <p>A closer look at the planning, installation, and finished details behind the work.</p>
      </header>
      {
        projects.map((project) => (
          <article class="luxury-project-item" data-reveal="up">
            <figure>
              <img src={project.image} width="1600" height="900" alt={project.alt} loading="lazy" />
            </figure>
            <div class="luxury-project-caption">
              <h3>{project.title}</h3>
              <p>{project.category}</p>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="luxury-case-study" aria-labelledby="featured-project-title">
    <figure class="luxury-case-study-lead" data-reveal="image">
      <img
        src="/images/projects/outdoor-living-ceiling.webp"
        width="1360"
        height="1020"
        alt="Covered patio with a cedar plank ceiling carrying recessed downlights, black ceiling fans, and flush-mounted speakers"
        loading="lazy"
      />
    </figure>
    <div class="luxury-case-study-panel" data-reveal="up">
      <p class="luxury-kicker">Featured project</p>
      <h2 id="featured-project-title">Covered patio lighting & audio.</h2>
      <p>
        Downlights, fan drops, and flush speakers set out across a cedar ceiling so the spacing reads
        deliberate and the wiring never does.
      </p>
      <dl class="luxury-case-study-meta">
        <div>
          <dt>Property</dt>
          <dd>Desert residence</dd>
        </div>
        <div>
          <dt>Scope</dt>
          <dd>Exterior lighting, fans, audio</dd>
        </div>
        <div>
          <dt>Focus</dt>
          <dd>Layout, blocking, concealed runs</dd>
        </div>
      </dl>
      <a class="luxury-text-link" href="/contact/">Discuss a similar project <span>→</span></a>
    </div>
  </section>

  <section class="luxury-principles" aria-label="V12 Electric project principles">
    <div class="luxury-principles-line" data-reveal="up">
      <h2>Plan clearly.</h2>
      <figure>
        <img
          src="/images/design-planning.webp"
          width="1536"
          height="1024"
          alt="Architectural electrical plans marked for coordination"
          loading="lazy"
        />
      </figure>
    </div>
    <div class="luxury-principles-line" data-reveal="up">
      <figure>
        <img
          src="/images/projects/panel-verification.webp"
          width="1600"
          height="900"
          alt="Organized service equipment being verified"
          loading="lazy"
        />
      </figure>
      <h2>Install cleanly.</h2>
    </div>
    <div class="luxury-principles-line" data-reveal="up">
      <h2>Verify everything.</h2>
      <figure>
        <img
          src="/images/proof/process-04-verify.webp"
          width="1920"
          height="1440"
          alt="Electrical installation receiving final testing"
          loading="lazy"
        />
      </figure>
    </div>
    <div class="luxury-principles-support">
      <p>Systems coordinated before installation begins.</p>
      <p>Work organized for safety, clarity, and serviceability.</p>
      <p>Final testing and a clear owner walkthrough.</p>
    </div>
  </section>
</InteriorLayout>
