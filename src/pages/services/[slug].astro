---
import type { GetStaticPaths } from "astro";
import InteriorLayout from "../../layouts/InteriorLayout.astro";
import ServiceHero from "../../components/ServiceHero.astro";
import ServiceStatement from "../../components/ServiceStatement.astro";
import ServiceScope from "../../components/ServiceScope.astro";
import ServiceSignals from "../../components/ServiceSignals.astro";
import ServiceMethod from "../../components/ServiceMethod.astro";
import ServiceProof from "../../components/ServiceProof.astro";
import ServiceNav from "../../components/ServiceNav.astro";
import LutronCredential from "../../components/LutronCredential.astro";
import FaqSection from "../../components/FaqSection.astro";
import { services, type Service } from "../../data/site";
import { serviceFaqs, toFaqSchema } from "../../data/seo";

export const getStaticPaths = (() =>
  services.map((service, index) => ({
    params: { slug: service.slug },
    props: { service, index },
  }))) satisfies GetStaticPaths;

const { service, index } = Astro.props as { service: Service; index: number };
const faqs = serviceFaqs[service.slug] ?? [];
const sequence = String(index + 1).padStart(2, "0");
const total = String(services.length).padStart(2, "0");
const pageUrl = `https://v12electric.com/services/${service.slug}/`;
const title = `${service.title} | V12 Electric Coachella Valley`;
const description = `V12 Electric provides ${service.title.toLowerCase()} across Palm Springs and the Coachella Valley, with clear planning, clean installation, and final testing.`;
const serviceSchema = {
  "@type": "Service",
  "@id": `${pageUrl}#service`,
  name: service.title,
  description,
  url: pageUrl,
  image: `https://v12electric.com${service.image}`,
  provider: { "@id": "https://v12electric.com/#business" },
  areaServed: {
    "@type": "Place",
    name: "Coachella Valley, California",
  },
  serviceType: service.title,
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: `${service.title} scope`,
    itemListElement: service.inclusions.map((item) => ({
      "@type": "Offer",
      itemOffered: { "@type": "Service", name: item.label, description: item.detail },
    })),
  },
};

// Each layout runs the same blocks in its own order so consecutive service
// pages never unfold the same way.
const sectionOrder = {
  split: ["statement", "scope", "signals", "method", "faq", "proof"],
  cinematic: ["scope", "statement", "signals", "method", "proof", "faq"],
  ledger: ["statement", "signals", "scope", "method", "proof", "faq"],
}[service.layout];
---

<InteriorLayout
  title={title}
  description={description}
  image={service.image}
  imageAlt={service.alt}
  breadcrumbs={[
    { name: "Services", path: "/services/" },
    { name: service.title, path: `/services/${service.slug}/` },
  ]}
  structuredData={[serviceSchema, toFaqSchema(faqs)]}
  active="services"
  overlayHeader={service.layout === "cinematic"}
  shellClass={`service-shell service-shell-${service.layout}`}
>
  <ServiceHero service={service} sequence={sequence} total={total} />

  {service.slug === "lutron-lighting-controls" && <LutronCredential link />}

  {
    sectionOrder.map((block) => (
      <Fragment>
        {block === "statement" && <ServiceStatement service={service} />}
        {block === "scope" && <ServiceScope service={service} />}
        {block === "signals" && <ServiceSignals service={service} />}
        {block === "method" && <ServiceMethod service={service} />}
        {block === "proof" && <ServiceProof service={service} />}
        {block === "faq" && (
          <FaqSection
            faqs={faqs}
            eyebrow={`${service.shortTitle} answers`}
            title={`Questions about ${service.title.toLowerCase()}.`}
            id={`${service.slug}-faq`}
          />
        )}
      </Fragment>
    ))
  }

  <ServiceNav service={service} />
</InteriorLayout>
