---
import InteriorLayout from "../../layouts/InteriorLayout.astro";
import PageHero from "../../components/PageHero.astro";
import ServiceIcon from "../../components/ServiceIcon.astro";
import LutronCredential from "../../components/LutronCredential.astro";
import { services } from "../../data/site";

const serviceListSchema = {
  "@type": "ItemList",
  name: "V12 Electric services",
  itemListElement: services.map((service, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: service.title,
    url: `https://v12electric.com/services/${service.slug}/`,
  })),
};
---

<InteriorLayout
  title="Electrical Services in Coachella Valley | V12 Electric"
  description="Explore EV charging, panel upgrades, repairs, lighting controls, inspections, and residential and commercial electrical services across the Coachella Valley."
  image="/images/electrical-systems.webp"
  imageAlt="Electrician working inside an organized electrical panel"
  breadcrumbs={[{ name: "Services", path: "/services/" }]}
  structuredData={serviceListSchema}
  active="services"
>
  <PageHero
    eyebrow="Services"
    title="Everything we get called for."
    description="Panels and service upgrades, EV charging, lighting and Lutron controls, repairs, inspections, and full residential and commercial wiring."
    image="/images/electrical-systems.webp"
    alt="Electrician working inside an organized electrical panel"
  />

  <section class="intro-split section-pad">
    <p class="section-label" data-reveal="up">Where it starts</p>
    <div data-reveal="up">
      <h2>The panel decides what everything else can do.</h2>
      <p class="body-large">
        Lighting, EV charging, HVAC, and pool equipment all end up at the same busbar. We check
        capacity first, then scope the rest of the work against what is actually available.
      </p>
    </div>
  </section>

  <section class="service-index" aria-label="V12 Electric services">
    {
      services.map((service, index) => (
        <article class="service-overview-item">
          <figure class="service-overview-media media-frame" data-reveal="image">
            <img src={service.image} width="1536" height="1024" alt={service.alt} loading="lazy" />
          </figure>
          <div class="service-overview-copy" data-reveal="up">
            <span class="index-number">0{index + 1}</span>
            <div class="service-overview-title">
              <ServiceIcon name={service.icon} />
              <p class="section-label">{service.shortTitle}</p>
            </div>
            <h2>{service.title}</h2>
            <p>{service.summary}</p>
            <ul class="service-overview-scope">
              {service.inclusions.slice(0, 3).map((item) => (
                <li>{item.label}</li>
              ))}
              <li class="service-overview-scope-more">
                +{service.inclusions.length - 3} more in a typical scope
              </li>
            </ul>
            {service.slug === "lutron-lighting-controls" && <LutronCredential compact />}
            <a class="text-link" href={`/services/${service.slug}/`}>
              Explore this service <span aria-hidden="true">↗</span>
            </a>
          </div>
        </article>
      ))
    }
  </section>

  <section class="capability-band section-pad">
    <p class="section-label">Where we work</p>
    <div class="capability-list">
      <span>Homes</span>
      <span>Businesses</span>
      <span>Remodels</span>
      <span>New construction</span>
    </div>
  </section>
</InteriorLayout>
