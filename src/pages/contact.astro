---
import InteriorLayout from "../layouts/InteriorLayout.astro";
import PageHero from "../components/PageHero.astro";
import { serviceAreaCities } from "../data/service-areas";
import { services } from "../data/site";

const bookingUrl = import.meta.env.PUBLIC_HOUSECALL_PRO_BOOKING_URL;
const contactEmail = import.meta.env.PUBLIC_CONTACT_EMAIL;
const hasInquiryEmail = Boolean(contactEmail);
const phoneNumber = "+17605676593";
const phoneDisplay = "(760) 567-6593";
const textLink = `sms:${phoneNumber}`;
---

<InteriorLayout
  title="Contact | V12 Electric"
  description="Contact V12 Electric for EV chargers, panel upgrades, residential and commercial electrical work, inspections, repairs, smart-home wiring, and lighting controls across the Coachella Valley."
  active="contact"
  showCta={false}
>
  <PageHero
    eyebrow="Project inquiries"
    title="Tell us what needs attention."
    description="Call or text V12 Electric about a repair, upgrade, EV charger, lighting project, or new installation."
    image="/images/hero-electricians-plans.webp"
    alt="Electricians coordinating a new construction project"
  />

  <section class:list={["contact-section", "section-pad", !hasInquiryEmail && "contact-section-direct"]}>
    <div class="contact-intro" data-reveal="up">
      <p class="section-label">Start a conversation</p>
      <h2>Call or text to get started.</h2>
      <p class="body-large">
        Tell us where the work is, what is happening, and when you need help. We will make the
        next step clear.
      </p>
      <dl class="contact-notes">
        <div>
          <dt>Call V12 Electric</dt>
          <dd><a class="contact-phone" href={`tel:${phoneNumber}`}>{phoneDisplay}</a></dd>
        </div>
        <div>
          <dt>Service area</dt>
          <dd>Palm Springs, Cathedral City, Desert Hot Springs, Rancho Mirage, Palm Desert, Indian Wells, La Quinta, Indio, and Coachella.</dd>
        </div>
        <div>
          <dt>Project types</dt>
          <dd>Homes, businesses, renovations, new construction, inspections, and electrical upgrades.</dd>
        </div>
      </dl>

      <div class="contact-action-panel">
        <p class="section-label">Talk with V12</p>
        <p>For the fastest start, call or text with the city, service needed, and a short description of the work.</p>
        <div class="contact-action-row">
          <a class="button button-primary" href={`tel:${phoneNumber}`}>Call {phoneDisplay}</a>
          <a class="text-link" href={textLink}>Text V12 Electric <span aria-hidden="true">↗</span></a>
        </div>
      </div>

      {
        bookingUrl && (
          <div class="booking-panel">
            <p class="section-label">Online scheduling</p>
            <p>Choose a time through the V12 Housecall Pro booking page.</p>
            <a class="button button-primary" href={bookingUrl} target="_blank" rel="noreferrer">
              Schedule online <span aria-hidden="true">↗</span>
            </a>
          </div>
        )
      }
    </div>

    {
      hasInquiryEmail && (
        <form
          class="inquiry-form"
          data-inquiry-form
          data-contact-email={contactEmail}
          data-reveal="up"
        >
          <div class="form-grid">
            <label>
              <span>Name</span>
              <input type="text" name="name" autocomplete="name" required />
            </label>
            <label>
              <span>Phone</span>
              <input type="tel" name="phone" autocomplete="tel" required />
            </label>
            <label>
              <span>Email <em>(optional)</em></span>
              <input type="email" name="email" autocomplete="email" />
            </label>
            <label>
              <span>City</span>
              <select name="city" required>
                <option value="">Select your city</option>
                {
                  serviceAreaCities.map((area) => <option value={area.slug}>{area.city}</option>)
                }
              </select>
            </label>
            <label class="form-span">
              <span>Property address</span>
              <input type="text" name="address" autocomplete="street-address" required />
            </label>
            <label class="form-span">
              <span>Service needed</span>
              <select name="service" required>
                <option value="">Select a service</option>
                {
                  services.map((service) => <option value={service.title}>{service.title}</option>)
                }
              </select>
            </label>
            <label>
              <span>Preferred timing <em>(optional)</em></span>
              <select name="timing">
                <option value="">Select timing</option>
                <option>As soon as practical</option>
                <option>Within the next 2–4 weeks</option>
                <option>Planning ahead</option>
              </select>
            </label>
            <label>
              <span>Project stage <em>(optional)</em></span>
              <select name="stage">
                <option value="">Select stage</option>
                <option>Repair or troubleshooting</option>
                <option>Planning or estimate</option>
                <option>In construction</option>
                <option>Ready to schedule</option>
              </select>
            </label>
            <label class="form-span">
              <span>Project details</span>
              <textarea name="details" rows="6" required placeholder="What needs power, lighting, inspection, repair, or upgrade?"></textarea>
            </label>
          </div>

          <label class="consent-check">
            <input type="checkbox" name="consent" required />
            <span>I acknowledge the <a href="/privacy/">Privacy Policy</a> and <a href="/terms/">Terms of Service</a>.</span>
          </label>

          <button class="button button-primary" type="submit">
            Send inquiry by email <span aria-hidden="true">↗</span>
          </button>
          <p class="form-note">
            Your email app will open with the project details filled in for V12 Electric.
          </p>
          <p class="form-status" role="status" aria-live="polite"></p>
        </form>
      )
    }
  </section>

  <section class="contact-close">
    <div data-reveal="up">
      <p class="section-label">Power · Lighting · Design</p>
      <h2>Start with a call or text.</h2>
    </div>
    <a class="button button-light" href={`tel:${phoneNumber}`}>Call V12 Electric <span aria-hidden="true">↗</span></a>
  </section>

  <script>
    const form = document.querySelector<HTMLFormElement>("[data-inquiry-form]");
    const status = form?.querySelector<HTMLElement>(".form-status");
    const citySelect = form?.querySelector<HTMLSelectElement>('select[name="city"]');
    const queryCity = new URLSearchParams(window.location.search).get("city");

    if (citySelect && queryCity && [...citySelect.options].some((option) => option.value === queryCity)) {
      citySelect.value = queryCity;
    }

    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      if (!status) return;

      const formData = new FormData(form);
      const city = citySelect?.selectedOptions[0]?.textContent ?? "";
      const email = form.dataset.contactEmail;
      const subject = `V12 Electric inquiry: ${String(formData.get("service") ?? "Electrical service")}`;
      const body = [
        `Name: ${formData.get("name") ?? ""}`,
        `Phone: ${formData.get("phone") ?? ""}`,
        `Email: ${formData.get("email") ?? ""}`,
        `City: ${city}`,
        `Property address: ${formData.get("address") ?? ""}`,
        `Service: ${formData.get("service") ?? ""}`,
        `Preferred timing: ${formData.get("timing") ?? ""}`,
        `Project stage: ${formData.get("stage") ?? ""}`,
        "",
        "Project details:",
        `${formData.get("details") ?? ""}`,
      ].join("\n");

      if (!email) return;
      window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      status.textContent = "Your email app is opening with the inquiry prepared.";
    });
  </script>
</InteriorLayout>
