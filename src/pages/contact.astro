---
import InteriorLayout from "../layouts/InteriorLayout.astro";
import PageHero from "../components/PageHero.astro";
import { serviceAreaCities } from "../data/service-areas";
import { services } from "../data/site";

const bookingUrl = import.meta.env.PUBLIC_HOUSECALL_PRO_BOOKING_URL;
const contactEmail = import.meta.env.PUBLIC_CONTACT_EMAIL;
const formEndpoint = import.meta.env.PUBLIC_FORM_ENDPOINT;
const phoneNumber = "+17605676593";
const phoneDisplay = "(760) 567-6593";
const textLink = `sms:${phoneNumber}`;
---

<InteriorLayout
  title="Contact V12 Electric | Coachella Valley Electrician"
  description="Call or text V12 Electric at (760) 567-6593, or request a quote for electrical service in Palm Springs and across the Coachella Valley."
  image="/images/contact-hero-service-van-v2.webp"
  imageAlt="V12 Electric service van ready for an appointment in the Coachella Valley"
  breadcrumbs={[{ name: "Contact", path: "/contact/" }]}
  structuredData={{
    "@type": "ContactPage",
    "@id": "https://v12electric.com/contact/#webpage",
    about: { "@id": "https://v12electric.com/#business" },
  }}
  active="contact"
  showCta={false}
>
  <PageHero
    eyebrow="Get in touch"
    title="Tell us what is going on."
    description="Call or text (760) 567-6593 about a repair, an upgrade, an EV charger, lighting, or something you are planning."
    image="/images/contact-hero-service-van-v2.webp"
    alt="V12 Electric service van ready for an appointment in the Coachella Valley"
  />

  <section class="contact-section section-pad">
    <div class="contact-intro" data-reveal="up">
      <p class="section-label">Fastest way in</p>
      <h2>Call or text. We answer.</h2>
      <p class="body-large">
        Send the city, what is happening, and a photo of the panel if you have one. That is usually
        enough for us to tell you whether it is a same-day visit or something to schedule.
      </p>
      <dl class="contact-notes">
        <div>
          <dt>Call or text</dt>
          <dd><a class="contact-phone" href={`tel:${phoneNumber}`}>{phoneDisplay}</a></dd>
        </div>
        <div>
          <dt>Where we work</dt>
          <dd>Palm Springs, Cathedral City, Desert Hot Springs, Rancho Mirage, Palm Desert, Indian Wells, La Quinta, Indio, and Coachella.</dd>
        </div>
        <div>
          <dt>What we take on</dt>
          <dd>Homes, businesses, remodels, new construction, inspections, and upgrades.</dd>
        </div>
      </dl>

      <div class="contact-action-panel">
        <p class="section-label">Straight to Eric</p>
        <p>Text is fine. Photos help.</p>
        <div class="contact-action-row">
          <a class="button button-primary" href={`tel:${phoneNumber}`}>Call {phoneDisplay}</a>
          <a class="text-link" href={textLink}>Text {phoneDisplay} <span aria-hidden="true">↗</span></a>
        </div>
      </div>

      {
        bookingUrl && (
          <div class="booking-panel">
            <p class="section-label">Online scheduling</p>
            <p>Choose a time through the V12 Housecall Pro booking page.</p>
            <a class="button button-primary" href={bookingUrl} target="_blank" rel="noreferrer">
              Schedule online <span aria-hidden="true">↗</span>
            </a>
          </div>
        )
      }
    </div>

    <div class="inquiry-panel" data-reveal="up">
      <div class="inquiry-head">
        <h2>Get a written estimate.</h2>
        <p>Four questions. We call back within one business day.</p>
      </div>

      <a class="inquiry-call" href={`tel:${phoneNumber}`}>
        <span>Need someone today?</span>
        <strong>Call {phoneDisplay}</strong>
      </a>

      <form
        class="inquiry-form"
        data-inquiry-form
        data-contact-email={contactEmail}
        data-form-endpoint={formEndpoint}
        novalidate
      >
        <div class="form-grid">
          <label>
            <span>Name <b aria-hidden="true">*</b></span>
            <input type="text" name="name" autocomplete="name" required />
          </label>
          <label>
            <span>Phone <b aria-hidden="true">*</b></span>
            <input type="tel" name="phone" inputmode="tel" autocomplete="tel" required />
          </label>
          <label>
            <span>City <b aria-hidden="true">*</b></span>
            <select name="city" required>
              <option value="">Where is the property?</option>
              {serviceAreaCities.map((area) => <option value={area.slug}>{area.city}</option>)}
            </select>
          </label>
          <label>
            <span>What do you need? <b aria-hidden="true">*</b></span>
            <select name="service" required>
              <option value="">Pick the closest one</option>
              {services.map((service) => <option value={service.title}>{service.title}</option>)}
              <option>Something else</option>
            </select>
          </label>
          <label class="form-span">
            <span>What is going on? <em>(optional)</em></span>
            <textarea name="details" rows="4" placeholder="What is happening, or what you are planning. A photo of the panel helps once we reply."></textarea>
          </label>
          <label class="form-span">
            <span>Email <em>(optional)</em></span>
            <input type="email" name="email" inputmode="email" autocomplete="email" />
          </label>
        </div>

        <p class="form-hp" aria-hidden="true">
          <label>Do not fill this in <input type="text" name="company" tabindex="-1" autocomplete="off" /></label>
        </p>

        <button class="button button-primary" type="submit">
          Get my estimate <span aria-hidden="true">→</span>
        </button>

        <p class="form-trust">Licensed, bonded, insured. CA Lic. #1114737. We do not share your information.</p>
        <p class="form-note">
          Rather talk it through? Call or text <a href={`tel:${phoneNumber}`}>{phoneDisplay}</a>.
        </p>
        <p class="form-status" role="status" aria-live="polite"></p>
      </form>

      <div class="inquiry-success" data-inquiry-success hidden>
        <p class="section-label">Request received</p>
        <h3>Got it.</h3>
        <p>We will call you back within one business day. If it cannot wait, call or text {phoneDisplay} and we will pick it up now.</p>
        <a class="button button-primary" href={`tel:${phoneNumber}`}>Call {phoneDisplay}</a>
      </div>
    </div>
  </section>

  <section class="contact-close">
    <div data-reveal="up">
      <p class="section-label">Palm Springs to Coachella</p>
      <h2>Start with a call or text.</h2>
    </div>
    <a class="button button-light" href={`tel:${phoneNumber}`}>Call V12 Electric <span aria-hidden="true">↗</span></a>
  </section>

  <script>
    const form = document.querySelector<HTMLFormElement>("[data-inquiry-form]");
    const success = document.querySelector<HTMLElement>("[data-inquiry-success]");
    const status = form?.querySelector<HTMLElement>(".form-status");
    const submit = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
    const citySelect = form?.querySelector<HTMLSelectElement>('select[name="city"]');
    const queryCity = new URLSearchParams(window.location.search).get("city");

    if (citySelect && queryCity && [...citySelect.options].some((option) => option.value === queryCity)) {
      citySelect.value = queryCity;
    }

    /** Marks the first invalid field so the visitor is not left hunting for it. */
    const findFirstInvalid = () => {
      const fields = form?.querySelectorAll<HTMLInputElement | HTMLSelectElement>("[required]") ?? [];
      for (const field of fields) {
        const invalid = !field.value.trim();
        field.closest("label")?.classList.toggle("is-invalid", invalid);
        if (invalid) return field;
      }
      return null;
    };

    form?.addEventListener("input", (event) => {
      const field = event.target as HTMLElement;
      if (field.closest("label.is-invalid")?.querySelector<HTMLInputElement>("[required]")?.value.trim()) {
        field.closest("label")?.classList.remove("is-invalid");
      }
    });

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!status || !submit) return;

      const firstInvalid = findFirstInvalid();
      if (firstInvalid) {
        status.textContent = "Fill in the highlighted fields and we will get right back to you.";
        status.dataset.tone = "error";
        firstInvalid.focus();
        return;
      }

      const formData = new FormData(form);
      if (formData.get("company")) return; // honeypot: silently drop bots

      const city = citySelect?.selectedOptions[0]?.textContent ?? "";
      const payload = {
        name: String(formData.get("name") ?? ""),
        phone: String(formData.get("phone") ?? ""),
        email: String(formData.get("email") ?? ""),
        city,
        service: String(formData.get("service") ?? ""),
        details: String(formData.get("details") ?? ""),
      };

      const showSuccess = () => {
        form.hidden = true;
        if (success) {
          success.hidden = false;
          success.setAttribute("tabindex", "-1");
          success.focus();
        }
      };

      const endpoint = form.dataset.formEndpoint;
      if (endpoint) {
        submit.disabled = true;
        status.dataset.tone = "";
        status.textContent = "Sending your request…";
        try {
          const response = await fetch(endpoint, {
            method: "POST",
            headers: { "Content-Type": "application/json", Accept: "application/json" },
            body: JSON.stringify(payload),
          });
          if (!response.ok) throw new Error(String(response.status));
          showSuccess();
          return;
        } catch {
          status.dataset.tone = "error";
          status.textContent = "That did not send. Call or text (760) 567-6593 and we will take the details directly.";
          submit.disabled = false;
          return;
        }
      }

      // No endpoint configured: fall back to opening the visitor's mail client.
      const email = form.dataset.contactEmail;
      if (!email) {
        status.dataset.tone = "error";
        status.textContent = "The form is not connected yet. Call or text (760) 567-6593 and we will help right now.";
        return;
      }

      const subject = `V12 Electric inquiry: ${payload.service || "Electrical service"}`;
      const body = [
        `Name: ${payload.name}`,
        `Phone: ${payload.phone}`,
        `Email: ${payload.email}`,
        `City: ${payload.city}`,
        `Service: ${payload.service}`,
        "",
        "Project details:",
        payload.details,
      ].join("\n");

      window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      status.dataset.tone = "";
      status.textContent = "Your email app is opening with the inquiry prepared. Press send to finish.";
    });
  </script>
</InteriorLayout>
