---
import InteriorLayout from "../layouts/InteriorLayout.astro";
import PageHero from "../components/PageHero.astro";
---

<InteriorLayout
  title="About V12 Electric | Coachella Valley Electrician"
  description="Learn how V12 Electric plans safe, serviceable power, lighting, and electrical systems for homes and businesses across the Coachella Valley."
  image="/images/about-hero-desert-worksite-v3.webp"
  imageAlt="Electrical plans and tools inside a desert home under construction"
  breadcrumbs={[{ name: "About", path: "/about/" }]}
  structuredData={{
    "@type": "AboutPage",
    "@id": "https://v12electric.com/about/#webpage",
    about: { "@id": "https://v12electric.com/#business" },
  }}
  active="about"
>
  <PageHero
    eyebrow="About V12"
    title="Electrical work that fits the whole project."
    description="We plan power, lighting, and service around how a home or business will actually be used."
    image="/images/about-hero-desert-worksite-v3.webp"
    alt="Electrical plans and tools inside a desert home under construction"
  />

  <section class="about-statement section-pad">
    <p class="section-label" data-reveal="up">Our point of view</p>
    <h2 data-reveal="up">
      The work needs to be safe, serviceable, and ready for the people using the space.
    </h2>
  </section>

  <section class="about-grid section-pad">
    <figure class="about-grid-media media-frame" data-reveal="image">
      <img
        src="/images/about-planning-still-life-v3.webp"
        width="1449"
        height="1086"
        alt="Electrical plans, lighting samples, and testing tools on a workbench"
        loading="lazy"
      />
    </figure>
    <div class="about-grid-copy" data-reveal="up">
      <p class="section-label">Why V12</p>
      <h2>One team for power, lighting, and project coordination.</h2>
      <p class="body-large">
        We review the existing electrical system, coordinate with homeowners, builders, and
        designers, and keep the work clear from planning through final testing.
      </p>
    </div>
  </section>

  <section class="values section-pad">
    <p class="section-label" data-reveal="up">What guides the work</p>
    <div class="value-list">
      <article data-reveal="up">
        <span>01</span>
        <h2>Assess the conditions.</h2>
        <p>Review capacity, equipment, and the practical needs of the space before recommending work.</p>
      </article>
      <article data-reveal="up" data-delay="1">
        <span>02</span>
        <h2>Explain the choices.</h2>
        <p>Make the scope, dependencies, and next steps easy to understand before installation begins.</p>
      </article>
      <article data-reveal="up" data-delay="2">
        <span>03</span>
        <h2>Leave clean work.</h2>
        <p>Organized installations are easier to inspect, maintain, and build on later.</p>
      </article>
    </div>
  </section>

  <section class="about-field-note">
    <figure class="media-frame image-drift" data-reveal="image">
      <img
        src="/images/about-rough-in-alignment-v2.webp"
        width="1448"
        height="1086"
        alt="Aligned electrical boxes and organized cable inside a framed wall"
        loading="lazy"
      />
    </figure>
    <blockquote data-reveal="up">The details behind the walls determine how the finished space performs.</blockquote>
  </section>
</InteriorLayout>
