---
import InteriorLayout from "../layouts/InteriorLayout.astro";
import PageHero from "../components/PageHero.astro";
import LutronCredential from "../components/LutronCredential.astro";
---

<InteriorLayout
  title="About V12 Electric | Coachella Valley Electrician"
  description="Eric owns and runs V12 Electric, a licensed Coachella Valley electrician working from a residential and IBEW commercial background."
  image="/images/about-hero-desert-worksite-v4.webp"
  imageAlt="V12 Electric hard hat, tools, and plans on a jobsite table with a tablet showing an electrical drawing"
  breadcrumbs={[{ name: "About", path: "/about/" }]}
  structuredData={{
    "@type": "AboutPage",
    "@id": "https://v12electric.com/about/#webpage",
    about: { "@id": "https://v12electric.com/#business" },
  }}
  active="about"
>
  <PageHero
    eyebrow="About V12"
    title="Who shows up."
    description="Eric answers the phone, writes the estimate, and is on the job."
    image="/images/about-hero-desert-worksite-v3.webp"
    alt="Electrical plans and tools inside a desert home under construction"
  />

  <section class="about-statement section-pad">
    <p class="section-label" data-reveal="up">How V12 got here</p>
    <div data-reveal="up">
      <h2>We would rather spend an hour looking than a week fixing a guess.</h2>
      <p class="body-large">
        Eric started out working with his older brother at Desert Elite Electric. From there he
        went through a franchise operation, which is where you learn how a job gets scheduled,
        priced, and closed out. He finished formal training, then worked through the IBEW on
        commercial and industrial jobs — where the drawings are right, the labeling gets checked,
        and nobody improvises. V12 Electric came out of all of it: residential and commercial work
        held to a commercial standard, with the estimate in writing before anyone opens a wall.
      </p>
    </div>
  </section>

  <section class="about-grid section-pad">
    <figure class="about-grid-media media-frame" data-reveal="image">
      <img
        src="/images/about-planning-still-life-v3.webp"
        width="1449"
        height="1086"
        alt="Electrical plans, lighting samples, and testing tools on a workbench"
        loading="lazy"
      />
    </figure>
    <div class="about-grid-copy" data-reveal="up">
      <p class="section-label">Why it stays consistent</p>
      <h2>The person who quotes it is the person who installs it.</h2>
      <p class="body-large">
        Plenty of shops send whoever is free that morning. You explain the job to an estimator,
        then explain it again to an installer seeing the panel for the first time. V12 does not
        work that way. Eric quotes it and Eric installs it — and the same goes for the lighting,
        because the panel decides what the controls can do.
      </p>
      <LutronCredential compact />
    </div>
  </section>

  <section class="values section-pad">
    <p class="section-label" data-reveal="up">Every job, in this order</p>
    <div class="value-list">
      <article data-reveal="up">
        <span>01</span>
        <h2>We open the panel.</h2>
        <p>Capacity, breaker condition, grounding, and what is already on each circuit — before any number gets quoted.</p>
      </article>
      <article data-reveal="up" data-delay="1">
        <span>02</span>
        <h2>You get it in plain English.</h2>
        <p>What is wrong, what it takes to fix, what it costs, and what can wait. In writing.</p>
      </article>
      <article data-reveal="up" data-delay="2">
        <span>03</span>
        <h2>We leave it labeled.</h2>
        <p>Typed directory, square runs, spare capacity. Easy to inspect, easy to add to.</p>
      </article>
    </div>
  </section>

  <section class="about-field-note">
    <figure class="media-frame image-drift" data-reveal="image">
      <img
        src="/images/about-rough-in-alignment-v2.webp"
        width="1448"
        height="1086"
        alt="Aligned electrical boxes and organized cable inside a framed wall"
        loading="lazy"
      />
    </figure>
    <blockquote data-reveal="up">Anyone can make it work on the day. The question is whether it is still right in ten years.</blockquote>
  </section>
</InteriorLayout>
