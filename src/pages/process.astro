---
import InteriorLayout from "../layouts/InteriorLayout.astro";
import PageHero from "../components/PageHero.astro";

const steps = [
  {
    number: "01",
    title: "We come look",
    copy: "We walk the property, pull the dead front, and see what is already on the panel. Repair calls start with a meter. Planned work starts with a walk through the rooms.",
  },
  {
    number: "02",
    title: "In writing",
    copy: "Scope, materials, price, and what is not included. Permit path if the job needs one. Nothing starts until you have read it.",
  },
  {
    number: "03",
    title: "We do the work",
    copy: "Agreed schedule, floors covered, cuts kept small. If something behind the wall changes the price, you hear it before we keep going.",
  },
  {
    number: "04",
    title: "Test and label",
    copy: "Every circuit loaded and verified, the directory typed, and a walkthrough so you know exactly what changed.",
  },
] as const;

const processSchema = {
  "@type": "HowTo",
  name: "How V12 Electric completes an electrical project",
  description:
    "V12 Electric's process for moving electrical repairs, upgrades, and planned projects from the first call through final testing.",
  step: steps.map((step, index) => ({
    "@type": "HowToStep",
    position: index + 1,
    name: step.title,
    text: step.copy,
    url: `https://v12electric.com/process/#step-${step.number}`,
  })),
};
---

<InteriorLayout
  title="Electrical Project Process | V12 Electric"
  description="How V12 Electric runs a job: we look at it, put the price in writing, do the work, then test and label it. Same order for planned and urgent work."
  image="/images/proof/process-hero-test.webp"
  imageAlt="Electrician testing an energized circuit with a circuit tracer"
  breadcrumbs={[{ name: "Process", path: "/process/" }]}
  structuredData={processSchema}
  active="process"
>
  <PageHero
    eyebrow="How we work"
    title="What actually happens."
    description="Assessment, a written estimate, then the work. Same order every time — planned or urgent."
    image="/images/proof/process-hero-test.webp"
    alt="Electrician testing an energized circuit with a Klein circuit tracer"
  />

  <section class="process-intro section-pad">
    <p class="section-label" data-reveal="up">Before anything starts</p>
    <div data-reveal="up">
      <h2>You will know the price before we start.</h2>
      <p class="body-large">
        Every planned job runs the same way: we come look, we write it up, you decide. Urgent calls
        run the same way on a shorter clock — we find the cause, tell you what the fix costs, and
        wait for a yes before we open anything up.
      </p>
    </div>
  </section>

  <section class="process-timeline section-pad">
    {
      steps.map((step) => (
        <article id={`step-${step.number}`} data-reveal="up">
          <span class="process-big-number">{step.number}</span>
          <div>
            <h2>{step.title}</h2>
            <p>{step.copy}</p>
          </div>
        </article>
      ))
    }
  </section>

  <section class="process-collaboration">
    <figure class="media-frame" data-reveal="image">
      <img
        src="/images/process-coordination-plans-v1.webp"
        width="1122"
        height="1402"
        alt="Marked-up electrical plans on a jobsite plan table"
        loading="lazy"
      />
    </figure>
    <div class="section-pad" data-reveal="up">
      <p class="section-label">Working with your team</p>
      <h2>Builders, designers, and the other trades.</h2>
      <p class="body-large">
        On new construction and remodels we are in the meetings, not waiting on a phone call.
        Electrical answers land when framing needs them, not after drywall.
      </p>
    </div>
  </section>

  <section class="handoff-band section-pad">
    <p class="section-label">The handoff</p>
    <h2>Tested. Labeled. Explained.</h2>
  </section>
</InteriorLayout>
