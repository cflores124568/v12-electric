---
import InteriorLayout from "../layouts/InteriorLayout.astro";
import PageHero from "../components/PageHero.astro";

const steps = [
  {
    number: "01",
    title: "Discover",
    copy: "We learn how the space will be used, review existing conditions, and define the project priorities.",
  },
  {
    number: "02",
    title: "Coordinate",
    copy: "We align power, lighting, equipment, controls, plans, and trade dependencies before work begins.",
  },
  {
    number: "03",
    title: "Build",
    copy: "Installation moves forward with clean routing, clear communication, and respect for the surrounding work.",
  },
  {
    number: "04",
    title: "Verify",
    copy: "We test the system, review the finished work, and walk through the result with the project team.",
  },
] as const;

const processSchema = {
  "@type": "HowTo",
  name: "How V12 Electric completes an electrical project",
  description:
    "V12 Electric's process for moving electrical repairs, upgrades, and planned projects from the first call through final testing.",
  step: steps.map((step, index) => ({
    "@type": "HowToStep",
    position: index + 1,
    name: step.title,
    text: step.copy,
    url: `https://v12electric.com/process/#step-${step.number}`,
  })),
};
---

<InteriorLayout
  title="Electrical Project Process | V12 Electric"
  description="See how V12 Electric moves electrical repairs, upgrades, and planned projects through discovery, coordination, installation, testing, and handoff."
  image="/images/proof/process-hero-test.webp"
  imageAlt="Electrician testing an energized circuit with a circuit tracer"
  breadcrumbs={[{ name: "Process", path: "/process/" }]}
  structuredData={processSchema}
  active="process"
>
  <PageHero
    eyebrow="Our process"
    title="From first call to final test."
    description="A practical electrical process for repairs, upgrades, and planned projects."
    image="/images/proof/process-hero-test.webp"
    alt="Electrician testing an energized circuit with a Klein circuit tracer"
  />

  <section class="process-intro section-pad">
    <p class="section-label" data-reveal="up">What happens next</p>
    <div data-reveal="up">
      <h2>Know the condition, the scope, and the next step.</h2>
      <p class="body-large">
        We start with the existing conditions and the work you need. From there, we coordinate the
        installation, verify the result, and make sure you know what has been completed.
      </p>
    </div>
  </section>

  <section class="process-timeline section-pad">
    {
      steps.map((step) => (
        <article id={`step-${step.number}`} data-reveal="up">
          <span class="process-big-number">{step.number}</span>
          <div>
            <h2>{step.title}</h2>
            <p>{step.copy}</p>
          </div>
        </article>
      ))
    }
  </section>

  <section class="process-collaboration">
    <figure class="media-frame" data-reveal="image">
      <img
        src="/images/process-coordination-plans-v1.webp"
        width="1122"
        height="1402"
        alt="Marked-up electrical plans on a jobsite plan table"
        loading="lazy"
      />
    </figure>
    <div class="section-pad" data-reveal="up">
      <p class="section-label">Collaboration</p>
      <h2>Clear coordination with the people on the project.</h2>
      <p class="body-large">
        We coordinate with homeowners, builders, designers, architects, and other trades so the
        electrical work is ready when the project needs it.
      </p>
    </div>
  </section>

  <section class="handoff-band section-pad">
    <p class="section-label">The handoff</p>
    <h2>Tested. Explained. Ready to use.</h2>
  </section>
</InteriorLayout>
