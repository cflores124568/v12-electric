---
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import ProjectCTA from "../../components/ProjectCTA.astro";
import ServiceIcon from "../../components/ServiceIcon.astro";
import SiteScripts from "../../components/SiteScripts.astro";
import { serviceAreaCities } from "../../data/service-areas";
import { services } from "../../data/site";

export const getStaticPaths = (() =>
  serviceAreaCities.map((city, cityIndex) => ({
    params: { slug: city.slug },
    props: { city, cityIndex },
  }))) satisfies GetStaticPaths;

type City = (typeof serviceAreaCities)[number];
const { city, cityIndex } = Astro.props as { city: City; cityIndex: number };

const serviceBySlug = Object.fromEntries(services.map((service) => [service.slug, service]));
const localServices = city.serviceSlugs.map((slug) => serviceBySlug[slug]).filter(Boolean);
const cityNumber = String(cityIndex + 1).padStart(2, "0");
const cityTotal = String(serviceAreaCities.length).padStart(2, "0");
const nearbyCities = serviceAreaCities.filter((area) => area.slug !== city.slug);
const contactHref = `/contact/?city=${city.slug}`;
const title = `${city.city} Electrician | V12 Electric`;
const description = `${city.focus} V12 Electric serves ${city.city}, California with planned, permitted electrical work.`;
const citySchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: `${city.city} electrical service`,
  description,
  areaServed: {
    "@type": "City",
    name: city.city,
    containedInPlace: { "@type": "State", name: "California" },
  },
  provider: {
    "@type": "Electrician",
    name: "V12 Electric",
    telephone: "+17605676593",
    url: "https://v12electric.com/",
  },
  serviceType: localServices.map((service) => service.title),
};
---

<BaseLayout title={title} description={description}>
  <div id="top" class="site-shell city-shell">
    <SiteHeader overlay />

    <main id="main-content">
      <section class="city-hero" aria-labelledby="city-hero-title">
        <figure class="city-hero-media">
          <img
            src={city.heroImage}
            width="1672"
            height="941"
            alt={city.heroAlt}
            fetchpriority="high"
          />
        </figure>

        <div class="city-hero-copy">
          <p class="city-sequence" data-reveal="up">
            <span>City</span> {cityNumber} / {cityTotal}
          </p>

          <div class="city-eyebrow" data-reveal="up">
            <ServiceIcon name="power" />
            <p>{city.city} electrician</p>
          </div>

          <h1 id="city-hero-title" data-reveal="up">
            <span>{city.headlineLead}</span>
            <strong>{city.headlineAccent}</strong>
          </h1>

          <p class="city-hero-summary" data-reveal="up" data-delay="1">{city.focus}</p>

          <div class="city-hero-actions" data-reveal="up" data-delay="2">
            <a class="button button-primary" href={contactHref}>
              {city.projectCta}
              <span aria-hidden="true">→</span>
            </a>
            <a class="city-hero-link" href="#city-services">
              View local services <span aria-hidden="true">→</span>
            </a>
          </div>

          <div class="city-local-note" data-reveal="up" data-delay="2">
            <span aria-hidden="true"></span>
            <div>
              <strong>Local service note</strong>
              <p>{city.localNote}</p>
            </div>
          </div>
        </div>
      </section>

      <section class="city-intro section-pad" aria-labelledby="city-intro-title">
        <div class="city-intro-aside" data-reveal="up">
          <p class="section-label">Electrical work in {city.city}</p>
          <span aria-hidden="true">{cityNumber}</span>
        </div>
        <div class="city-intro-copy" data-reveal="up">
          <h2 id="city-intro-title">The property comes before the parts list.</h2>
          <p class="city-intro-focus">{city.focus}</p>
          <p>{city.fieldNote}</p>
        </div>
      </section>

      <section class="city-technical" aria-labelledby="city-technical-title">
        <div class="city-technical-heading section-pad" data-reveal="up">
          <p class="section-label">Plan before installation</p>
          <h2 id="city-technical-title">Local details belong in the electrical plan.</h2>
          <p>
            Capacity, utility requirements, equipment location, and inspection timing are reviewed
            together before work begins.
          </p>
        </div>

        <dl class="city-technical-list">
          <div data-reveal="up">
            <dt>01 / Utility</dt>
            <dd>{city.utility}</dd>
          </div>
          <div data-reveal="up" data-delay="1">
            <dt>02 / Permit authority</dt>
            <dd>{city.permitAuthority}</dd>
            <a href={city.permitUrl} target="_blank" rel="noreferrer">
              View permit information <span aria-hidden="true">↗</span>
            </a>
          </div>
          <div data-reveal="up" data-delay="2">
            <dt>03 / Field note</dt>
            <dd>{city.fieldNote}</dd>
          </div>
        </dl>
      </section>

      <section id="city-services" class="city-services section-pad" aria-labelledby="city-services-title">
        <div class="city-services-heading" data-reveal="up">
          <p class="section-label">Common work in {city.city}</p>
          <h2 id="city-services-title">The right scope for the property.</h2>
        </div>

        <div class="city-service-list">
          {
            localServices.map((service, index) => (
              <a href={`/services/${service.slug}/`} data-reveal="up" data-delay={String(index % 3)}>
                <span>{String(index + 1).padStart(2, "0")}</span>
                <div>
                  <h3>{service.title}</h3>
                  <p>{service.summary}</p>
                </div>
                <span aria-hidden="true">↗</span>
              </a>
            ))
          }
        </div>
      </section>

      <section class="city-faq section-pad" aria-labelledby="city-faq-title">
        <div class="city-faq-heading" data-reveal="up">
          <p class="section-label">Local question</p>
          <h2 id="city-faq-title">What homeowners ask in {city.city}.</h2>
        </div>

        <div class="city-faq-content">
          <details open data-reveal="up">
            <summary>{city.localFaq.question}</summary>
            <p>{city.localFaq.answer}</p>
          </details>
          <details data-reveal="up">
            <summary>Do electrical projects in {city.city} need permits?</summary>
            <p>
              Permit requirements depend on the scope. We identify the likely path, coordinate with
              {` ${city.permitAuthority}`}, and account for inspection before installation is scheduled.
            </p>
          </details>
          <details data-reveal="up">
            <summary>What should I send before calling?</summary>
            <p>
              Send the property address, a short description of the problem or planned equipment,
              and photos of the panel and work area when available. That gives us a useful place to start.
            </p>
          </details>
        </div>
      </section>

      <nav class="city-directory section-pad" aria-label="Other cities served">
        <p class="section-label">Across the Coachella Valley</p>
        <h2>Continue through the valley.</h2>
        <div>
          {
            nearbyCities.map((area) => (
              <a href={`/service-areas/${area.slug}/`}>
                {area.city} <span aria-hidden="true">↗</span>
              </a>
            ))
          }
        </div>
      </nav>

      <ProjectCTA />
    </main>

    <SiteFooter />
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(citySchema)}></script>
  <SiteScripts />
</BaseLayout>
