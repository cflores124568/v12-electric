---
import BaseLayout from "../layouts/BaseLayout.astro";
import BrandLogo from "../components/BrandLogo.astro";
import ServiceAreaMap from "../components/ServiceAreaMap.astro";
import Reviews from "../components/Reviews.astro";
import ProjectGallery from "../components/ProjectGallery.astro";
import { services as allServices } from "../data/site";

const homepageServices = allServices.slice(0, 6);
---

<BaseLayout
  title="V12 Electric | Power, Lighting & Design"
  description="V12 Electric serves the Coachella Valley with EV chargers, panel upgrades, residential and commercial electrical, inspections, repairs, smart-home wiring, and lighting controls."
>
  <div id="top" class="site-shell home-shell">
    <header class="site-header" data-reveal="fade">
      <BrandLogo class="header-logo" />

      <nav id="primary-nav" class="primary-nav" aria-label="Primary navigation">
        <a href="/services/">Services</a>
        <a href="/projects/">Projects</a>
        <a href="/about/">About</a>
        <a href="/process/">Process</a>
        <a href="/contact/">Contact</a>
      </nav>

      <a class="button button-primary header-cta" href="tel:+17605676593">Call or text Eric</a>

      <button
        class="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
      >
        <span></span>
        <span></span>
        <span></span>
      </button>

      <div id="mobile-menu" class="mobile-menu" aria-hidden="true" inert>
        <nav aria-label="Mobile navigation">
          <a href="/services/">Services</a>
          <a href="/projects/">Projects</a>
          <a href="/about/">About</a>
          <a href="/process/">Process</a>
          <a href="/contact/">Contact</a>
        </nav>
        <a class="button button-primary" href="tel:+17605676593">Call Eric</a>
      </div>
    </header>

    <main id="main-content">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="hero-kicker" data-reveal="up">Coachella Valley electrical service</p>
          <h1 id="hero-title" data-reveal="up">
            <span>Power.</span>
            <span>Lighting.</span>
            <span class="hero-accent">Done right.</span>
          </h1>
          <p data-reveal="up" data-delay="1">
            Panel upgrades, EV chargers, lighting, repairs, and electrical work for homes and
            businesses across the Coachella Valley.
          </p>
          <div class="button-row" data-reveal="up" data-delay="2">
            <a class="button button-primary" href="tel:+17605676593">
              Call or text Eric
              <span aria-hidden="true">→</span>
            </a>
            <a class="button button-outline" href="#projects">See recent work</a>
          </div>
        </div>

        <div class="hero-media" data-reveal="image">
          <img
            src="/images/proof/commercial-service.webp"
            width="2304"
            height="1792"
            alt="A Coachella Valley commercial property illuminated at dusk beneath the San Jacinto Mountains"
            fetchpriority="high"
          />
        </div>
      </section>

      <section id="services" class="services section-pad">
        <div class="section-heading" data-reveal="up">
          <p class="section-label">Our services</p>
          <h2>Complete electrical solutions.</h2>
        </div>

        <div class="service-grid">
          {
            homepageServices.map((service, index) => (
              <article class="service-item" data-reveal="up" data-delay={String(index)}>
                <figure class="service-image media-frame">
                  <img
                    src={service.image}
                    width="1448"
                    height="1086"
                    alt={service.alt}
                    loading="lazy"
                  />
                </figure>
                <div class="service-copy">
                  <p class="service-index">0{index + 1}</p>
                  <h3>{service.title}</h3>
                  <p>{service.summary}</p>
                  <a class="text-link" href={`/services/${service.slug}/`}>
                    View service <span aria-hidden="true">→</span>
                  </a>
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <section class="home-trust" aria-labelledby="trust-title">
        <div class="home-trust-heading section-pad" data-reveal="up">
          <p class="section-label">Why choose V12 Electric?</p>
          <h2 id="trust-title">Clear work. Thoughtful planning.</h2>
        </div>
        <div class="home-trust-list">
          <article data-reveal="up">
            <p class="home-trust-index">01</p>
            <h3>Experienced</h3>
            <p>Skilled craftsmanship and attention to detail on every project.</p>
          </article>
          <article data-reveal="up">
            <p class="home-trust-index">02</p>
            <h3>Reliable</h3>
            <p>We show up, follow through, and stand behind our work.</p>
          </article>
          <article data-reveal="up">
            <p class="home-trust-index">03</p>
            <h3>Built to last</h3>
            <p>Quality materials and clean installations made for desert conditions.</p>
          </article>
          <article data-reveal="up">
            <p class="home-trust-index">04</p>
            <h3>Property-aware</h3>
            <p>Electrical decisions made around the way each home or business works.</p>
          </article>
        </div>
      </section>

      <section id="about" class="manifesto section-pad">
        <div class="manifesto-copy" data-reveal="up">
          <p class="section-label">What we look for first</p>
          <h2>Desert loads ask more from a system.</h2>
          <p class="body-large">
            Heat, HVAC, pools, appliances, and EV charging all meet at the panel. We start with
            the existing conditions, then plan the work around how the property is actually used.
          </p>
        </div>

        <figure class="manifesto-media media-frame" data-reveal="image">
          <img
            src="/images/conduit-installation.webp"
            width="1448"
            height="1086"
            alt="Neatly arranged electrical conduit inside a framed commercial wall"
            loading="lazy"
          />
        </figure>
      </section>

      <section id="projects" class="project-story" aria-labelledby="project-title">
        <figure class="project-story-media media-frame image-drift" data-reveal="image">
          <img
            src="/images/panel-upgrade.webp"
            width="1536"
            height="1024"
            alt="Completed modern electrical panel upgrade with organized conductors"
            loading="lazy"
          />
        </figure>
        <div class="project-story-copy section-pad" data-reveal="up">
          <p class="section-label">Palm Springs · Panel capacity review</p>
          <h2>When the panel has to carry more.</h2>
          <p class="body-large">
            EV chargers, HVAC, pools, kitchens, and additions add demand. We assess panel capacity,
            circuit loads, and the safest path forward before upgrading service equipment.
          </p>
          <a class="text-link" href="/contact/">Discuss your project <span aria-hidden="true">→</span></a>
        </div>
      </section>

      <ProjectGallery />

      <Reviews />

      <ServiceAreaMap />

    </main>

    <footer class="site-footer">
      <div class="footer-brand">
        <BrandLogo />
        <p>Electrical service for Coachella Valley homes and businesses.</p>
      </div>

        <div>
          <h2>Services</h2>
          <a href="/services/electrical-systems/">Electrical Systems</a>
          <a href="/services/ev-charger-installation/">EV Charger Installation</a>
          <a href="/services/panel-service-upgrades/">Panel & Service Upgrades</a>
          <a href="/services/lutron-lighting-controls/">Lutron Lighting & Controls</a>
          <a href="/services/design-planning/">Design & Planning</a>
        </div>

      <div>
        <h2>Company</h2>
        <a href="/about/">About</a>
        <a href="/process/">Our Process</a>
        <a href="/projects/">Projects</a>
      </div>

        <div id="project-inquiries">
          <h2>Project inquiries</h2>
          <p>Serving Palm Springs through Coachella with power, lighting, and electrical service.</p>
          <a class="footer-phone" href="tel:+17605676593">(760) 567-6593</a>
          <a class="text-link" href="/contact/">Start a conversation <span aria-hidden="true">↗</span></a>
        </div>

        <div class="footer-meta">
          <p>© 2026 V12 Electric.</p>
          <p><a href="/privacy/">Privacy</a> · <a href="/terms/">Terms</a></p>
        </div>
    </footer>
  </div>

  <script>
    const menuButton = document.querySelector<HTMLButtonElement>(".menu-toggle");
    const mobileMenu = document.querySelector<HTMLElement>(".mobile-menu");

    const setMenuState = (open: boolean) => {
      if (!menuButton || !mobileMenu) return;
      menuButton.setAttribute("aria-expanded", String(open));
      menuButton.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      mobileMenu.setAttribute("aria-hidden", String(!open));
      mobileMenu.toggleAttribute("inert", !open);
      document.body.classList.toggle("menu-open", open);
    };

    menuButton?.addEventListener("click", () => {
      setMenuState(menuButton.getAttribute("aria-expanded") !== "true");
    });

    mobileMenu?.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => setMenuState(false));
    });

    window.addEventListener("keydown", (event) => {
      if (event.key === "Escape") setMenuState(false);
    });

    const revealItems = document.querySelectorAll<HTMLElement>("[data-reveal]");
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (reduceMotion || !("IntersectionObserver" in window)) {
      revealItems.forEach((item) => item.classList.add("is-visible"));
    } else {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          });
        },
        { threshold: 0.16 },
      );

      revealItems.forEach((item) => observer.observe(item));
    }
  </script>
</BaseLayout>
