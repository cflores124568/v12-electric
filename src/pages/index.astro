---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import ServiceAreaMap from "../components/ServiceAreaMap.astro";
import Reviews from "../components/Reviews.astro";
import ProjectGallery from "../components/ProjectGallery.astro";
import ServiceIcon from "../components/ServiceIcon.astro";
import FaqSection from "../components/FaqSection.astro";
import LutronCredential from "../components/LutronCredential.astro";
import { services as allServices } from "../data/site";
import { homeFaqs, toFaqSchema } from "../data/seo";

const categoryStrip = [
  {
    icon: "power" as const,
    title: "Residential",
    summary: "Remodels, repairs, and additions in desert homes.",
    href: "/services/residential-electrical/",
  },
  {
    icon: "commercial" as const,
    title: "Commercial",
    summary: "Storefronts, offices, and equipment circuits.",
    href: "/services/commercial-electrical/",
  },
  {
    icon: "ev-charging" as const,
    title: "EV Charging",
    summary: "Level 2 installs sized to the panel you have.",
    href: "/services/ev-charger-installation/",
  },
  {
    icon: "lighting" as const,
    title: "Lighting Design",
    summary: "Layered lighting and Lutron control systems.",
    href: "/services/lutron-lighting-controls/",
  },
];

const homepageServices = allServices.slice(0, 6);
---

<BaseLayout
  title="Coachella Valley Electrician | V12 Electric"
  description="V12 Electric provides EV charger installation, panel upgrades, repairs, lighting, and residential and commercial electrical service across the Coachella Valley."
  image="/images/og-card.jpg"
  structuredData={toFaqSchema(homeFaqs)}
>
  <div id="top" class="site-shell home-shell">
    <SiteHeader overlay />

    <main id="main-content">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="hero-kicker" data-reveal="up">Coachella Valley electrical service</p>
          <h1 id="hero-title" data-reveal="up">
            <span>Power.</span>
            <span>Lighting.</span>
            <span class="hero-accent">Done right.</span>
          </h1>
          <p data-reveal="up" data-delay="1">
            Eric looks at the job before he prices it. Panel upgrades, EV chargers, lighting, and
            repairs across the Coachella Valley.
          </p>
          <div class="button-row" data-reveal="up" data-delay="2">
            <a class="button button-primary" href="tel:+17605676593">
              Call or text us
              <span aria-hidden="true">→</span>
            </a>
            <a class="button button-outline" href="#projects">See recent work</a>
          </div>

          <div class="hero-trust-row" data-reveal="up" data-delay="3">
            <ul class="hero-trust-badges">
              <li><ServiceIcon name="shield-check" /> Licensed</li>
              <li><ServiceIcon name="shield-check" /> Bonded</li>
              <li><ServiceIcon name="shield-check" /> Insured</li>
            </ul>
            <p class="hero-trust-license">CA Lic. #<span>1114737</span></p>
            <LutronCredential compact link />
          </div>
        </div>

        <div class="hero-media" data-reveal="image">
          <video
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            poster="/images/hero-desert-night-poster.webp"
            aria-label="A contemporary Palm Desert estate with layered architectural and landscape lighting at night"
          >
            <source src="/videos/hero-desert-night.mp4" type="video/mp4" />
            <img
              src="/images/hero-bighorn-night.webp"
              width="1717"
              height="916"
              alt="A contemporary Palm Desert estate with layered architectural and landscape lighting at night"
              fetchpriority="high"
            />
          </video>
        </div>
      </section>

      <section class="category-strip">
        <div class="category-grid">
          {
            categoryStrip.map((category, index) => (
              <article class="category-item" data-reveal="up" data-delay={String(index)}>
                <ServiceIcon name={category.icon} />
                <h3>{category.title}</h3>
                <p>{category.summary}</p>
                <a class="text-link" href={category.href}>
                  Learn more <span aria-hidden="true">→</span>
                </a>
              </article>
            ))
          }
        </div>

        <p class="category-tagline">
          <span>Palm Springs to Coachella.</span>
          <ServiceIcon name="power" />
          <span>Nine cities, one phone number.</span>
        </p>
      </section>

      <section id="services" class="services section-pad">
        <div class="section-heading" data-reveal="up">
          <p class="section-label">What we do</p>
          <h2>One outlet or the whole house.</h2>
        </div>

        <div class="service-grid">
          {
            homepageServices.map((service, index) => (
              <article class="service-item" data-reveal="up" data-delay={String(index)}>
                <figure class="service-image media-frame">
                  <img
                    src={service.image}
                    width="1448"
                    height="1086"
                    alt={service.alt}
                    loading="lazy"
                  />
                </figure>
                <div class="service-copy">
                  <h3>{service.title}</h3>
                  <p>{service.summary}</p>
                  <a class="text-link" href={`/services/${service.slug}/`}>
                    View service <span aria-hidden="true">→</span>
                  </a>
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <section class="home-trust" aria-labelledby="trust-title">
        <div class="home-trust-heading section-pad" data-reveal="up">
          <p class="section-label">Why V12</p>
          <h2 id="trust-title">No surprises on the invoice.</h2>
        </div>
        <div class="home-trust-list">
          <article data-reveal="up">
            <h3>Written first</h3>
            <p>Scope and price before we start. If something behind the wall changes it, you hear it first.</p>
          </article>
          <article data-reveal="up">
            <h3>Cause first</h3>
            <p>Even same-day calls start with a diagnosis. We find it, price it, and wait for a yes.</p>
          </article>
          <article data-reveal="up">
            <h3>Same electrician</h3>
            <p>Eric walks the job, writes the estimate, and is there for the install.</p>
          </article>
          <article data-reveal="up">
            <h3>Labeled clean</h3>
            <p>Typed panel directory, square conduit, spare capacity left where it is cheap to leave it.</p>
          </article>
        </div>
      </section>

      <section id="about" class="manifesto section-pad">
        <div class="manifesto-copy" data-reveal="up">
          <p class="section-label">What we look at first</p>
          <h2>Nothing out here runs light.</h2>
          <p class="body-large">
            Two condensers cycling all July. A pool pump, a spa heater, a well pump. A range, a
            dryer, and a car charging overnight. It all lands on one panel — often a panel sized
            decades ago for a swamp cooler and a window unit. We add up what the property actually
            pulls before we tell you what it needs.
          </p>
        </div>

        <figure class="manifesto-media media-frame" data-reveal="image">
          <img
            src="/images/conduit-installation.webp"
            width="1448"
            height="1086"
            alt="Neatly arranged electrical conduit inside a framed commercial wall"
            loading="lazy"
          />
        </figure>
      </section>

      <section id="projects" class="project-story" aria-labelledby="project-title">
        <figure class="project-story-media media-frame image-drift" data-reveal="image">
          <img
            src="/images/panel-upgrade.webp"
            width="1536"
            height="1024"
            alt="Completed modern electrical panel upgrade with organized conductors"
            loading="lazy"
          />
        </figure>
        <div class="project-story-copy section-pad" data-reveal="up">
          <p class="section-label">Palm Springs · Panel capacity review</p>
          <h2>Zinsco panels are still out here.</h2>
          <p class="body-large">
            Zinsco, Federal Pacific, Challenger — a lot of valley housing stock still runs on
            equipment that was obsolete before the last remodel. Add an EV charger, a mini-split,
            or a new kitchen and it stops being theoretical. We open the panel, read the equipment,
            calculate the load, and tell you whether you need a new service or just a subpanel.
          </p>
          <a class="text-link" href="/contact/">Get it looked at <span aria-hidden="true">→</span></a>
        </div>
      </section>

      <ProjectGallery />

      <Reviews />

      <ServiceAreaMap />

      <FaqSection
        faqs={homeFaqs}
        eyebrow="Electrical service answers"
        title="Before you call an electrician."
        id="home-faq"
      />

    </main>

    <SiteFooter />
  </div>

  <script>
    const menuButton = document.querySelector<HTMLButtonElement>(".menu-toggle");
    const mobileMenu = document.querySelector<HTMLElement>(".mobile-menu");

    const setMenuState = (open: boolean) => {
      if (!menuButton || !mobileMenu) return;
      menuButton.setAttribute("aria-expanded", String(open));
      menuButton.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      mobileMenu.setAttribute("aria-hidden", String(!open));
      mobileMenu.toggleAttribute("inert", !open);
      document.body.classList.toggle("menu-open", open);
    };

    menuButton?.addEventListener("click", () => {
      setMenuState(menuButton.getAttribute("aria-expanded") !== "true");
    });

    mobileMenu?.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => setMenuState(false));
    });

    window.addEventListener("keydown", (event) => {
      if (event.key === "Escape") setMenuState(false);
    });

    const revealItems = document.querySelectorAll<HTMLElement>("[data-reveal]");
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (reduceMotion || !("IntersectionObserver" in window)) {
      revealItems.forEach((item) => item.classList.add("is-visible"));
    } else {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          });
        },
        { threshold: 0.16 },
      );

      revealItems.forEach((item) => observer.observe(item));
    }
  </script>
</BaseLayout>
