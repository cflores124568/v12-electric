---
import "@fontsource/bebas-neue/latin-400.css";
import "@fontsource/oxanium/latin-700.css";
import "@fontsource/michroma/latin-400.css";
import "@fontsource/k2d/latin-400.css";
import "@fontsource/k2d/latin-600.css";
import "@fontsource/k2d/latin-700.css";
import "@fontsource/montserrat/latin-400.css";
import "@fontsource/montserrat/latin-500.css";
import "@fontsource/montserrat/latin-600.css";
import "@fontsource/montserrat/latin-700.css";
import "../styles/global.css";
import { serviceAreaNames } from "../data/service-areas";
import { services } from "../data/site";

interface BreadcrumbItem {
  name: string;
  path: string;
}

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  pageType?: "website" | "article";
  breadcrumbs?: readonly BreadcrumbItem[];
  structuredData?: Record<string, unknown> | readonly Record<string, unknown>[];
  noIndex?: boolean;
}

const {
  title,
  description,
  image = "/images/og-card.jpg",
  imageAlt = "V12 Electric — electrical service in the Coachella Valley",
  pageType = "website",
  breadcrumbs = [],
  structuredData = [],
  noIndex = false,
} = Astro.props;

const siteUrl = Astro.site ?? new URL("https://v12electric.com");
const canonical = new URL(Astro.url.pathname, siteUrl);
const socialImage = new URL(image, siteUrl);
const socialImageHasKnownDimensions = image === "/images/og-card.jpg";
const businessId = new URL("/#business", siteUrl).href;
const websiteId = new URL("/#website", siteUrl).href;
const webpageId = `${canonical.href}#webpage`;

const businessSchema = {
  "@type": "Electrician",
  "@id": businessId,
  name: "V12 Electric",
  url: new URL("/", siteUrl).href,
  description:
    "Coachella Valley electrical contractor for EV charging, panel upgrades, residential and commercial electrical work, repairs, lighting controls, and project planning.",
  logo: {
    "@type": "ImageObject",
    url: new URL("/images/icon-512.png", siteUrl).href,
    width: 512,
    height: 512,
  },
  image: {
    "@type": "ImageObject",
    url: new URL("/images/og-card.jpg", siteUrl).href,
    width: 1200,
    height: 630,
  },
  telephone: "+17605676593",
  contactPoint: {
    "@type": "ContactPoint",
    telephone: "+17605676593",
    contactType: "customer service",
    areaServed: "US-CA",
    availableLanguage: "English",
  },
  areaServed: serviceAreaNames.map((name) => ({
    "@type": "City",
    name,
    containedInPlace: { "@type": "State", name: "California" },
  })),
  knowsAbout: services.map((service) => service.title),
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Electrical services",
    itemListElement: services.map((service) => ({
      "@type": "Offer",
      itemOffered: {
        "@type": "Service",
        "@id": new URL(`/services/${service.slug}/#service`, siteUrl).href,
        name: service.title,
        url: new URL(`/services/${service.slug}/`, siteUrl).href,
      },
    })),
  },
};

const websiteSchema = {
  "@type": "WebSite",
  "@id": websiteId,
  url: new URL("/", siteUrl).href,
  name: "V12 Electric",
  description: "Power, lighting, and electrical planning for Coachella Valley properties.",
  publisher: { "@id": businessId },
  inLanguage: "en-US",
};

const webpageSchema = {
  "@type": "WebPage",
  "@id": webpageId,
  url: canonical.href,
  name: title,
  description,
  isPartOf: { "@id": websiteId },
  about: { "@id": businessId },
  primaryImageOfPage: {
    "@type": "ImageObject",
    url: socialImage.href,
  },
  inLanguage: "en-US",
};

const breadcrumbSchema = breadcrumbs.length
  ? {
      "@type": "BreadcrumbList",
      "@id": `${canonical.href}#breadcrumb`,
      itemListElement: [
        { name: "Home", path: "/" },
        ...breadcrumbs,
      ].map((item, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: item.name,
        item: new URL(item.path, siteUrl).href,
      })),
    }
  : null;

const additionalSchemas = Array.isArray(structuredData) ? structuredData : [structuredData];
const schemaGraph = [
  businessSchema,
  websiteSchema,
  webpageSchema,
  ...(breadcrumbSchema ? [breadcrumbSchema] : []),
  ...additionalSchemas,
].filter((schema) => Object.keys(schema).length > 0);

const jsonLd = { "@context": "https://schema.org", "@graph": schemaGraph };
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={noIndex
        ? "noindex, nofollow"
        : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"}
    />
    <meta name="author" content="V12 Electric" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#065bff" />
    <meta name="geo.region" content="US-CA" />
    <meta name="geo.placename" content="Coachella Valley" />

    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en-US" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    <link rel="icon" type="image/png" href="/images/icon-512.png" />
    <link rel="apple-touch-icon" href="/images/icon-512.png" />

    <meta property="og:type" content={pageType} />
    <meta property="og:site_name" content="V12 Electric" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:secure_url" content={socialImage} />
    {socialImageHasKnownDimensions && <meta property="og:image:width" content="1200" />}
    {socialImageHasKnownDimensions && <meta property="og:image:height" content="630" />}
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <slot />
    <aside class="mobile-contact-bar" aria-label="Contact V12 Electric">
      <a href="tel:+17605676593">Call</a>
      <a href="sms:+17605676593">Text</a>
    </aside>
  </body>
</html>
