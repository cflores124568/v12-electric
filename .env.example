# Configure only after the V12 business destinations are confirmed.

# Where quote requests are POSTed as JSON (Formspree, Web3Forms, Netlify, etc.).
# Set this. Without it the form falls back to opening the visitor's mail app,
# which loses most submissions on mobile.
PUBLIC_FORM_ENDPOINT=

# Fallback destination used only when PUBLIC_FORM_ENDPOINT is unset.
# Defaults to v12electricinc@gmail.com in code; set this to override it.
PUBLIC_CONTACT_EMAIL=
PUBLIC_HOUSECALL_PRO_BOOKING_URL=
